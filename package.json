{
  "name": "fides",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ai-double": "node scripts/ai-double.mjs",
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "dev": "next dev -p 3002",
    "lint": "eslint . && oxlint --deny-warnings .",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f app worker",
    "local:reset": "docker compose down -v && docker compose up -d --build",
    "local:up": "docker compose up -d --build",
    "queue:redrive": "node --env-file-if-exists=.env scripts/redrive-dlq.mjs",
    "sink": "node scripts/message-sink.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "smoke:queue": "node --env-file-if-exists=.env scripts/smoke-queue.mjs",
    "start": "next start -p 3002",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "verify:logins": "node --env-file-if-exists=.env scripts/verify-logins.mjs",
    "worker": "node scripts/worker.mjs"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1110.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "oxlint": "1.76.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^3.2.7"
  }
}
