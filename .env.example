# Fides · configuración de la versión local dockerizada.
#
# La pila arranca sin `.env`. Copia este archivo como `.env` (ignorado por Git)
# sólo cuando quieras cambiar algún valor predeterminado.
# La única contraseña incluida es una credencial pública e intencional del demo
# sintético. Nunca la reutilices fuera de este entorno. No escribas aquí una
# contraseña real, un secreto de proveedor ni datos personales.
#
#   cp .env.example .env
#   docker compose up -d --build

# --- cuentas del demo --------------------------------------------------------

# Contraseña pública común de las 19 cuentas sintéticas (ADR-0082). Está
# versionada deliberadamente y es también el valor predeterminado del seed y de
# Docker Compose: la pila arranca aunque no copies este archivo.
FIDES_SEED_PASSWORD=FidesDemo123!

# --- servicios locales ------------------------------------------------------

# Token compartido entre el worker y el endpoint interno `/api/interno/trabajos`.
# Sólo protege la comunicación entre contenedores locales.
FIDES_WORKER_TOKEN=fides-worker-local

# Dirección con la que tú abres la aplicación desde el navegador. La usan los
# enlaces del Firmante y las direcciones del portal en los mensajes capturados.
FIDES_PUBLIC_URL=http://localhost:3002

# Dirección de contacto que muestra la landing en la acción `Contactar`.
FIDES_CONTACT_EMAIL=contacto@fides.local

# --- valores que Docker Compose ya define por servicio -----------------------
# Sólo necesitas estos si ejecutas la aplicación o los scripts fuera de Docker
# (`npm run dev`, `npm run db:migrate`, `npm run worker`, …).

# PostgreSQL local publicado en 127.0.0.1:54329.
DATABASE_URL=postgres://fides:fides_local_only@127.0.0.1:54329/fides

# Dirección base de la aplicación web. Dentro de Compose el worker usa
# `http://app:3002`; fuera de Docker apunta al puerto publicado.
FIDES_APP_URL=http://localhost:3002

# Directorio privado de objetos (evidencia, PDF, paquetes fríos, temporales).
# Dentro de Compose es un volumen montado en /var/lib/fides/objects.
FIDES_OBJECT_DIR=./.data/objetos

# Captura local de correo y WhatsApp. Bandeja legible en http://localhost:8025
FIDES_SINK_URL=http://127.0.0.1:8025/api/messages
FIDES_SINK_STATE_FILE=./.data/mensajes.json

# Doble local controlado del proveedor de revisión asistida.
# Nunca es un proveedor real: http://localhost:8030 documenta sus resultados.
FIDES_AI_URL=http://127.0.0.1:8030/analizar

# Cola local compatible con SQS. Docker Compose define estos valores para el
# worker; fuera de Docker, omítelos para conservar el polling directo de
# PostgreSQL o levanta `queue` y activa explícitamente el modo SQS.
FIDES_QUEUE_MODE=database
FIDES_QUEUE_ENDPOINT=http://127.0.0.1:9324
FIDES_JOB_QUEUE=fides-background-jobs
FIDES_JOB_DLQ=fides-background-jobs-dlq
AWS_REGION=elasticmq
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# La sesión local viaja por HTTP; en producción esta variable no debe existir.
FIDES_INSECURE_COOKIES=true

# Permite la grabación sintética de prueba del recorrido del Firmante, para
# recorrer la evidencia de video en un equipo sin cámara. Sólo el entorno local
# sintético la habilita: con datos reales el video debe nacer en la sesión.
FIDES_ALLOW_SYNTHETIC_EVIDENCE=true
